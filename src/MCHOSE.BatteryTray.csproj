<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>MCHOSE.BatteryTray</AssemblyName>
    <RootNamespace>MchoseBatteryTray</RootNamespace>
    <Version>10.0.0</Version>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <InformationalVersion>10.0.0</InformationalVersion>
    <AssemblyTitle>MCHOSE Battery Tray</AssemblyTitle>
    <Product>MCHOSE Battery Tray</Product>
    <Company>MCHOSE Battery Tray contributors</Company>
    <Description>Battery monitor for supported MCHOSE wireless headsets.</Description>
    <Copyright>Copyright © 2026 MCHOSE Battery Tray contributors</Copyright>
    <ApplicationIcon>..\assets\MCHOSE-Battery-Tray.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>
</Project>
